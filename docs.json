      "og:image": "https://docs.movetogetherfitness.com/images/og.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "twitter:image": "https://docs.movetogetherfitness.com/images/og.png",
      "twitter:card": "summary_large_image"
    }
  },
  "integrations": {
    "gtm": {
      "tagId": "GTM-N8T99VWS"
    }
  },
